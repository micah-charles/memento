{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/micah-charles/memento/blob/main/schemas/source-record.schema.json",
  "title": "MEMENTO Source record",
  "description": "An original preserved material item. A Source is immutable wherever possible and is never replaced by a transcript or model output.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "record_type", "source_id", "source_type", "created_at"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.1-draft" },
    "record_type": { "type": "string", "const": "source" },
    "source_id": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": ["audio", "video", "photo", "document", "conversation_turn", "handwritten_letter"]
    },
    "file_path": { "type": ["string", "null"] },
    "sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "recorded_at": { "type": ["string", "null"], "format": "date-time" },
    "session_id": { "type": ["string", "null"] },
    "turn_id": { "type": ["string", "null"] },
    "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
    "immutable": { "type": "boolean", "default": true },
    "notes": { "type": ["string", "null"] }
  }
}

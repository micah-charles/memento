<Window
    x:Class="Memento.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MEMENTO">
    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="MEMENTO" FontSize="32" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="16">
            <TextBlock Text="今日想傾啲乜？" FontSize="28" HorizontalAlignment="Center" />
            <TextBlock Text="Local archive foundation is ready." FontSize="18" HorizontalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Row="2" Text="Recording is off · Local archive" FontSize="16" HorizontalAlignment="Center" />
    </Grid>
</Window>
